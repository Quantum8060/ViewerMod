{
	"schemaVersion": 1,
	"id": "viewer-mod",
	"version": "${version}",
	"name": "Viewer Mod",
	"description": "Opt-in local archive of chunks received while connected to a server.",
	"authors": [
		"qmc"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/viewer-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"xyz.qmc.ViewerMod"
		],
		"client": [
			"xyz.qmc.client.ViewerModClient"
		]
	},
	"mixins": [
		{
			"config": "viewer-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
